[core]
  excludesfile = ~/.gitignore
  editor = vim
  pager = delta
[color]
  ui = auto
[format]
  pretty = %Cblue%h%Creset %Cgreen[%cr]%Creset (%an) %s
[alias]
  b = branch -a -v
  c = commit -m
  a = add
  ap = add -p
  co = checkout
  d = diff
  pl = pull --rebase
  ps = push
  s = status --short
  cp = cherry-pick
  pr = pull-request
  merged = log --date-order --tags --simplify-by-decoration --pretty=format:\"%Cblue%h %Cgreen%<|(20)[%cr]%Creset %C(auto)%<|(41)%d %s\"
  ob = for-each-ref --sort=committerdate refs/heads/ --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(color:red)%(objectname:short)%(color:reset) - %(contents:subject) - %(authorname) (%(color:green)%(committerdate:relative)%(color:reset))'
[help]
  autocorrect = 1
[push]
  default = current
  autoSetupRemote = true
[remote "origin"]
  # Keep origin/HEAD tracking the remote's default branch on every fetch.
  # The default only creates it once, so a main/master rename leaves it
  # stale — and everything diffing vs "the branch base" (nvim pr.info,
  # bin/git-branch-status) silently uses the old trunk.
  followRemoteHEAD = always
[delta]
  navigate = true
  light = false
  side-by-side = false
  line-numbers = true
[interactive]
  diffFilter = delta --color-only
[init]
  defaultBranch = main
[gpg]
  format = ssh
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
  # Trust store for VERIFYING ssh signatures (%G?, --show-signature). Without
  # it every commit verifies as N — which false-trips signed-commit guards
  # (e.g. band-van's release.sh assert_signed).
  allowedSignersFile = ~/.ssh/allowed_signers
[commit]
  gpgsign = true
[user]
  name = Mat Pataki
  email = matpataki@gmail.com
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILH8m/LZhOLEOFtZ2VDsmemChw3A/He/zklcqQecKJ3z
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[includeIf "gitdir:~/code/1password/"]
  path = ~/.gitconfig.1password
# b5 must live under GOPATH (README; lcl serves assets from $GOPATH/src/go.1password.io/b5).
# ~/code/1password/b5 is a symlink to it, but git matches the physical path, so it needs its own rule.
[includeIf "gitdir:~/go/src/go.1password.io/"]
  path = ~/.gitconfig.1password
[url "git@github.com-1password:agilebits-inc/"]
  insteadOf = git@github.com:agilebits-inc/
[url "git@github.com-1password:agilebits-inc/"]
  insteadOf = ssh://git@github.com/agilebits-inc/
[url "git@github.com-1password:agilebits-inc/"]
  insteadOf = https://github.com/agilebits-inc/
