#!/usr/bin/env bash
# secretive-sign — ssh-keygen pointed at Secretive's agent socket.
#
# Used as gpg.ssh.program in agent sessions (see claude-config/settings.json +
# ~/.gitconfig-agent-signing), so git signing reaches the Secure-Enclave-backed
# agent key without hijacking the session's SSH_AUTH_SOCK for everything else
# (pushes and homelab ssh keep their own agent).
set -euo pipefail

SOCK="$HOME/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"

if [ ! -S "$SOCK" ]; then
  echo "secretive-sign: Secretive agent socket not found at $SOCK — is Secretive installed and its agent running? (dotfiles: secretive/setup_secretive.sh)" >&2
  exit 1
fi

SSH_AUTH_SOCK="$SOCK" exec ssh-keygen "$@"
